generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Visibility {
  visible
  hidden
}

model User {
  id          String       @id @default(cuid())
  username    String       @unique
  passwordHash String?
  cloudbaseEnvId String?
  cloudbaseSubject String?
  phone       String?      @unique
  role        UserRole     @default(USER)
  createdAt   DateTime     @default(now())
  spaces      Space[]
  deployments Deployment[] @relation("OwnerDeployments")
  administeredSpaces SpaceAdministrator[]
  comments    DeploymentComment[]
  notifications Notification[]

  @@unique([cloudbaseEnvId, cloudbaseSubject])
}

model Notification {
  id          String @id @default(cuid())
  recipientId String
  recipient   User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind        String @db.VarChar(32)
  title       String @db.VarChar(255)
  content     String @db.Text
  href        String @db.VarChar(1024)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt, id])
}

model Space {
  id          String       @id @default(cuid())
  ownerUserId String
  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  downloadsEnabled Boolean @default(false)
  deployments Deployment[]
  tags        SpaceTag[]
  administrators SpaceAdministrator[]

  @@index([expiresAt])
}

model SpaceAdministrator {
  spaceId String
  userId String
  createdAt DateTime @default(now())
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId])
}

model SpaceTag {
  id          String       @id @default(cuid())
  spaceId     String
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())
  deployments DeploymentTag[]

  @@unique([spaceId, name])
  @@index([spaceId])
}

model DeploymentTag {
  deploymentId String
  tagId        String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  tag          SpaceTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deploymentId, tagId])
  @@index([tagId])
}

model Deployment {
  id             String      @id @default(cuid())
  title          String
  description    String      @default("") @db.VarChar(2000)
  comments       DeploymentComment[]
  publicSlug     String      @unique
  viewCount      Int         @default(0)
  ownerUserId    String?
  owner          User?       @relation("OwnerDeployments", fields: [ownerUserId], references: [id], onDelete: SetNull)
  spaceId        String?
  space          Space?      @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  tags           DeploymentTag[]
  rootPath       String
  previousRootPath String?
  expiresAt      DateTime
  visibility     Visibility  @default(visible)
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?
  uploaderIp     String?
  uploaderAgent  String?

  @@index([expiresAt])
  @@index([ownerUserId])
  @@index([spaceId])
}

model DeploymentComment {
  id           String @id @default(cuid())
  deploymentId String
  authorId     String
  content      String @db.Text
  createdAt    DateTime @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  author       User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([deploymentId, createdAt])
  @@index([authorId])
}

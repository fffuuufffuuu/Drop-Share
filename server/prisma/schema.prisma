generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Visibility {
  visible
  hidden
}

model User {
  id          String       @id @default(cuid())
  username    String       @unique
  passwordHash String
  phone       String?      @unique
  role        UserRole     @default(USER)
  createdAt   DateTime     @default(now())
  spaces      Space[]
  deployments Deployment[] @relation("OwnerDeployments")
}

model Space {
  id          String       @id @default(cuid())
  ownerUserId String
  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  downloadsEnabled Boolean @default(false)
  deployments Deployment[]
  tags        SpaceTag[]

  @@index([expiresAt])
}

model SpaceTag {
  id          String       @id @default(cuid())
  spaceId     String
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())
  deployments DeploymentTag[]

  @@unique([spaceId, name])
  @@index([spaceId])
}

model DeploymentTag {
  deploymentId String
  tagId        String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  tag          SpaceTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deploymentId, tagId])
  @@index([tagId])
}

model Deployment {
  id             String      @id @default(cuid())
  title          String
  publicSlug     String      @unique
  ownerUserId    String?
  owner          User?       @relation("OwnerDeployments", fields: [ownerUserId], references: [id], onDelete: SetNull)
  spaceId        String?
  space          Space?      @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  tags           DeploymentTag[]
  rootPath       String
  expiresAt      DateTime
  visibility     Visibility  @default(visible)
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?
  uploaderIp     String?
  uploaderAgent  String?

  @@index([expiresAt])
  @@index([ownerUserId])
  @@index([spaceId])
}
